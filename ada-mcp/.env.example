# Runtime
PORT=3002

# ADA database access (server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required. Dedicated secret for this MCP service; do not reuse WORKER_SECRET.
ADA_MCP_API_KEY=replace-with-a-long-random-secret

# Required in production. Comma-separated public hostnames, without protocol or port.
# Example Railway custom/generated domain:
ADA_MCP_ALLOWED_HOSTS=ada-mcp-production.up.railway.app

# Optional. Comma-separated browser origins allowed to call the server.
# Requests without Origin (normal server-to-server MCP calls) are still accepted.
ADA_MCP_ALLOWED_ORIGINS=
