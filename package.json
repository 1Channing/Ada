{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "1.2.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:parity": "tsx test/parity/business-logic-parity.test.ts",
    "test:parity:parsing": "tsx test/parity/parsing-parity.test.ts",
    "test:parity:e2e": "tsx test/parity/e2e-parity.test.ts",
    "test:parity:scraping": "tsx test/parity/scraping-parity.test.ts",
    "test:parity:all": "npm run test:parity && npm run test:parity:parsing && npm run test:parity:e2e",
    "test:median": "tsx test/median-calculation.test.ts",
    "test:site-deal": "tsx test/site-deal-url.test.ts",
    "test:agents": "tsx test/agents-mail.test.ts",
    "test:annuaire": "tsx test/agents-annuaire.test.ts",
    "test:qualification": "tsx test/agents-qualification.test.ts",
    "test:premier-mail": "tsx test/agents-premier-mail.test.ts",
    "test:sites": "tsx test/agents-sites.test.ts",
    "test:dana": "tsx test/agents-dana.test.ts",
    "test:recherche": "tsx test/agents-recherche.test.ts",
    "test:approfondie": "tsx test/agents-approfondie.test.ts",
    "test:bilan": "tsx test/agents-bilan.test.ts",
    "test:reponse": "tsx test/agents-reponse.test.ts",
    "test:ciblee": "tsx test/agents-recherche-ciblee.test.ts",
    "test:banc": "tsx test/agents-banc.test.ts",
    "test:memoire": "tsx test/agents-memoire.test.ts",
    "test:linkedin": "tsx test/agents-linkedin.test.ts",
    "test:tableur": "tsx test/sheet-sync.test.ts",
    "test:plan": "tsx test/agents-plan.test.ts",
    "test:cote": "tsx test/agents-cote.test.ts",
    "test:workflow": "tsx test/agents-workflow.test.ts",
    "test": "npm run test:parity && npm run test:parity:parsing && npm run test:parity:e2e && npm run test:parity:scraping && npm run test:median && npm run test:site-deal && npm run test:agents && npm run test:annuaire && npm run test:qualification && npm run test:premier-mail && npm run test:sites && npm run test:dana && npm run test:recherche && npm run test:approfondie && npm run test:bilan && npm run test:reponse && npm run test:ciblee && npm run test:banc && npm run test:memoire && npm run test:linkedin && npm run test:tableur && npm run test:plan && npm run test:cote && npm run test:workflow",
    "build:worker": "cd worker && npm ci && npm run build",
    "start:worker": "cd worker && npm start",
    "gate": "tsc --noEmit -p tsconfig.app.json && tsx scripts/grammar-gate.mts && vite build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.344.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.2",
    "tesseract.js": "^6.0.1",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.58.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "playwright": "^1.58.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
