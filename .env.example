# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Scheduler Secret (for triggering Edge Functions)
# This should match SCHEDULER_CRON_SECRET in your Supabase Edge Function environment
VITE_SCHEDULER_CRON_SECRET=your_scheduler_secret_here

# Execution Mode (REQUIRED)
# 'api' = Remote execution via Worker (PRODUCTION - ALWAYS USE THIS)
# 'local' = Browser execution (DEVELOPMENT ONLY)
VITE_SCRAPER_MODE=api

# Zyte API key (for Zyte /v1/extract)
# Get your API key from https://www.zyte.com/
# Only needed for local mode development
VITE_ZYTE_API_KEY=your_zyte_api_key_here

# Optional non-Vite variant (also supported by the code)
ZYTE_API_KEY=your_zyte_api_key_here

# OpenAI API Key (for AI analysis)
VITE_OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE
OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE

# ═══════════════════════════════════════════════════════════════════════════
# UNIFIED PIPELINE FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════════════════

# Enable shared study-core module for unified execution
# Set to "true" to use the unified pipeline (same logic for instant & scheduled)
# Set to "false" to use legacy implementations
# DEFAULT: true (unified pipeline is now production-ready)
VITE_USE_SHARED_CORE=true
USE_SHARED_CORE=true

# Enable parity validation logging
# Set to "false" to disable parity checking logs
VITE_ENABLE_PARITY_VALIDATION=true
ENABLE_PARITY_VALIDATION=true

# Enable detailed debug logging
# Set to "true" to see verbose execution logs
VITE_ENABLE_DEBUG_LOGGING=false
ENABLE_DEBUG_LOGGING=false

# ═══════════════════════════════════════════════════════════════════════════
# WORKER CONFIGURATION (for Mapping Auto feature)
# ═══════════════════════════════════════════════════════════════════════════

# Worker API endpoint
# Local: http://localhost:3001
# Production: https://your-worker-domain.com
VITE_WORKER_URL=http://localhost:3001

# Worker authentication secret
# This must match the WORKER_SECRET configured in your worker instance
VITE_WORKER_SECRET=your_worker_secret_here
