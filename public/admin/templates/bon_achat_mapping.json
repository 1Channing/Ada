{
  "template_name": "Bon d'achat",
  "template_file": "pdf-templates/Bon_d_achat.pdf",
  "has_form_fields": true,
  "use_coordinates": true,
  "boxed_fields": [
    "vehicle.plate_number",
    "vehicle.vin"
  ],
  "field_mappings": {
    "vehicle.brand": "brand",
    "vehicle.model": "model",
    "vehicle.plate_number": "plate_number",
    "vehicle.vin": "vin",
    "vehicle.first_registration_date": "first_registration_date",
    "vehicle.mileage": "mileage",
    "transaction.transaction_price": "transaction_price",
    "seller.full_name": "seller_name",
    "transaction.transaction_date": "transaction_date"
  },
  "coordinate_mappings": {
    "vehicle.brand": { "x": 120, "y": 595, "size": 10 },
    "vehicle.model": { "x": 120, "y": 580, "size": 10 },
    "vehicle.plate_number": { "x": 150, "y": 565, "size": 10, "type": "boxed", "char_spacing": 10 },
    "vehicle.vin": { "x": 165, "y": 550, "size": 10, "type": "boxed", "char_spacing": 8 },
    "vehicle.first_registration_date": { "x": 180, "y": 535, "size": 10, "format": "date" },
    "vehicle.mileage": { "x": 140, "y": 520, "size": 10 },
    "transaction.transaction_price": { "x": 400, "y": 455, "size": 10, "format": "currency" },
    "seller.full_name": { "x": 80, "y": 425, "size": 10 },
    "transaction.transaction_date": { "x": 170, "y": 280, "size": 10, "format": "date" }
  }
}
