PORT=3001
# OBLIGATOIRE : sans lui, le worker refuse tous les appels (503).
# Même valeur dans les secrets des fonctions Supabase (WORKER_SECRET).
WORKER_SECRET=your-secure-random-secret-here
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ZYTE_API_KEY=your-zyte-api-key
# Développement local seulement : accepter les appels sans secret.
# WORKER_ALLOW_NO_SECRET=1
# Origines navigateur autorisées (aucune par défaut — le worker est appelé
# de serveur à serveur).
# WORKER_ALLOWED_ORIGINS=
# Adresse publique d'ADA, pour les liens des e-mails de rappel (12/10) — défaut https://ada.app.
# ADA_APP_URL=https://ada.app
