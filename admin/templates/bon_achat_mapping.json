    "vehicle.vin": { "x": 165, "y": 550, "size": 10 },
    "vehicle.first_registration_date": { "x": 180, "y": 535, "size": 10, "format": "date" },
    "vehicle.mileage": { "x": 140, "y": 520, "size": 10 },
    "transaction.transaction_price": { "x": 400, "y": 455, "size": 10 },
    "seller.full_name": { "x": 80, "y": 425, "size": 10 },
